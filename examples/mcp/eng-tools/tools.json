{
  "serverInfo": {
    "name": "eng-tools",
    "version": "2.3.1"
  },
  "protocolVersions": [
    "2026-07-28",
    "2025-11-25",
    "2025-06-18"
  ],
  "instructions": "Engineering tools for the code host and team chat. Act only on work assigned to you.",
  "tools": [
    {
      "name": "search_issues",
      "title": "Search issues",
      "description": "Search issues across repositories you can see. By default returns open issues assigned to you.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "all"
            ],
            "description": "Issue state. Defaults to open."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Maximum results. Defaults to 20."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_issue",
      "title": "Get issue",
      "description": "Get one issue with its title, body, labels and assignees.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "number": {
            "type": "integer",
            "description": "Issue number."
          }
        },
        "required": [
          "owner",
          "repo",
          "number"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "add_issue_comment",
      "title": "Comment on an issue",
      "description": "Add a comment to an issue as yourself.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "number": {
            "type": "integer",
            "description": "Issue number."
          },
          "body": {
            "type": "string",
            "description": "Comment text, Markdown."
          }
        },
        "required": [
          "owner",
          "repo",
          "number",
          "body"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "post_message",
      "title": "Post to a channel",
      "description": "Post a message to a team chat channel you belong to, by the channel's name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel name, such as platform-team."
          },
          "message": {
            "type": "string",
            "description": "Message text, Markdown."
          }
        },
        "required": [
          "channel",
          "message"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "list_issue_comments",
      "title": "List issue comments",
      "description": "List the comments on an issue, oldest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "number": {
            "type": "integer",
            "description": "Issue number."
          }
        },
        "required": [
          "owner",
          "repo",
          "number"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "close_issue",
      "title": "Close an issue",
      "description": "Close an issue. Add a comment first if you want to say why.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "number": {
            "type": "integer",
            "description": "Issue number."
          }
        },
        "required": [
          "owner",
          "repo",
          "number"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "get_file_contents",
      "title": "Read a file",
      "description": "Read a file from a repository's default branch, as text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "path": {
            "type": "string",
            "description": "File path in the repository."
          }
        },
        "required": [
          "owner",
          "repo",
          "path"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "update_file",
      "title": "Update a file",
      "description": "Replace a file's content with a commit, on the default branch or a new branch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "path": {
            "type": "string",
            "description": "File path in the repository."
          },
          "content": {
            "type": "string",
            "description": "The new file content, as text."
          },
          "message": {
            "type": "string",
            "description": "Commit message."
          },
          "branch": {
            "type": "string",
            "description": "Branch to commit to. Defaults to main."
          },
          "new_branch": {
            "type": "string",
            "description": "Create this branch from `branch` for the commit."
          }
        },
        "required": [
          "owner",
          "repo",
          "path",
          "content",
          "message"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true
      }
    },
    {
      "name": "reply_in_thread",
      "title": "Reply in a thread",
      "description": "Reply to a chat message in its thread, by the message's id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "string",
            "description": "The id of the message to reply to."
          },
          "message": {
            "type": "string",
            "description": "Reply text, Markdown."
          }
        },
        "required": [
          "post_id",
          "message"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "create_pull_request",
      "title": "Open a pull request",
      "description": "Open a pull request from a branch into main.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (organization or user)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "head": {
            "type": "string",
            "description": "The branch with the changes."
          },
          "title": {
            "type": "string",
            "description": "Pull request title."
          },
          "body": {
            "type": "string",
            "description": "Description, Markdown."
          }
        },
        "required": [
          "owner",
          "repo",
          "head",
          "title"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    }
  ]
}
